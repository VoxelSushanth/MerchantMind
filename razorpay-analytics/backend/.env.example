# Application Settings
APP_NAME=Razorpay Analytics SaaS
DEBUG=true
API_PREFIX=/api/v1

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/razorpay_analytics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# Security - CHANGE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FERNET_KEY=

# Razorpay OAuth - Get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/razorpay/callback
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Embeddings (OpenAI)
EMBEDDINGS_MODEL=text-embedding-3-large
EMBEDDINGS_DIMENSION=1536

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Rate Limiting
FREE_TIER_QUERIES_PER_DAY=20

# Logging
LOG_LEVEL=INFO
